stateDiagram-v2
  [*] --> STATIONARY

  STATIONARY --> MOVING: IMU accel > threshold
  MOVING --> STATIONARY: IMU accel <= threshold

  state "Stationary policy" as STP {
    [*] --> Learning
    Learning --> Stable: estimate converged\nAND neighbor set stable
    Stable --> Learning: neighbor set changes\nOR estimate becomes stale/uncertain
  }

  state "Sensing (radio TX)" as SENS {
    [*] --> Fast
    Fast --> Slow: STATIONARY + Stable
    Slow --> Fast: MOVING\nOR Stationary Learning
  }

  state "Cloud publishing" as PUB {
    [*] --> Publish
    Publish --> Suppress: STATIONARY + Stable\n(no new info)
    Suppress --> Publish: first report\nOR topology change\nOR stale timer
  }

  STATIONARY --> STP
  STATIONARY --> SENS
  STATIONARY --> PUB
  MOVING --> SENS
  MOVING --> PUB
